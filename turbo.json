{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"] },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "gate:plan": {
      "dependsOn": ["^build"],
      "env": ["UMBRAL_EDE_ID", "UMBRAL_EDE_STATUS", "UMBRAL_UNIT_TESTS", "UMBRAL_SAD_PATHS", "UMBRAL_COVERAGE_TARGET"]
    },
    "gate:commit": {
      "dependsOn": ["test", "typecheck", "gate:plan"],
      "env": ["UMBRAL_IMPACTED_FILES"]
    }
  }
}
