{
  "name": "@umbral/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names next,ws \"next dev\" \"tsx watch server/ws-server.ts\"",
    "dev:next": "next dev",
    "dev:ws": "tsx watch server/ws-server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@umbral/contracts": "workspace:*",
    "@umbral/orchestrator": "workspace:*",
    "@umbral/persistence": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "next": "^15",
    "node-pty": "^1.1.0",
    "react": "^19",
    "react-dom": "^19",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
